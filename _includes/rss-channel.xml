{% assign language = page.lang | default: 'pt' %}
{% assign t = site.data.i18n[language] %}
{% assign language_home = '/' %}
{% if language == 'en' %}{% assign language_home = '/en/' %}{% endif %}
{% assign localized_posts = site.posts | where: 'lang', language %}
<rss version="2.0">
  <channel>
    <title>4LagDev // {{ t.posts | xml_escape }}</title>
    <link>{{ language_home | absolute_url | xml_escape }}</link>
    <description>{{ t.rss_description | xml_escape }}</description>
    <language>{{ t.html_lang }}</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    {% for post in localized_posts %}
      <item>
        <title>{{ post.title | xml_escape }}</title>
        <link>{{ post.url | absolute_url | xml_escape }}</link>
        <guid isPermaLink="true">{{ post.url | absolute_url | xml_escape }}</guid>
        <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
        <description>{{ post.excerpt | strip_html | strip_newlines | xml_escape }}</description>
        {% if post.categories and post.categories != empty %}
          {% for category in post.categories %}{% assign translated_category = t.categories[category] | default: category %}<category>{{ translated_category | xml_escape }}</category>{% endfor %}
        {% else %}
          <category>{{ t.posts | xml_escape }}</category>
        {% endif %}
      </item>
    {% endfor %}
  </channel>
</rss>
